# Copy to .env.local (never committed). Local values come from `supabase status -o env`.
# OuWork must never point at the OurWorld Supabase or Vercel projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only
ANTHROPIC_API_KEY=              # server only (from phase W4)
AI_DAILY_TOKEN_LIMIT=200000     # daily AI token cap per workspace
CRON_SECRET=                    # protects the digest cron route (phase W6)
